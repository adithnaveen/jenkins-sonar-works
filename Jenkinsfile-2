pipeline {
  agent any
  options {
    buildDiscarder(logRotator(numToKeepStr: '5'))
  }

  environment {
    SONAR_URL = 'http://sonarqube:9000'
    SONAR_PROJECT_KEY = 'com.example:demo'
    SONAR_TOKEN = credentials('sonar-token-global')   // Jenkins secret
  }

  stages {

    stage('Scan') {
      steps {
        withSonarQubeEnv('sq1') {
          sh './mvnw clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:3.9.0.2155:sonar'
        }
      }
    }

    stage('Quality Gate') {
      steps {
        timeout(time: 6, unit: 'MINUTES') {
          script {
            def qg = waitForQualityGate abortPipeline: false
            if (qg.status != 'OK') {
              error "❌ SonarQube Quality Gate failed: ${qg.status}"
            }
          }
        }
      }
    }

    stage('Custom Coverage Check (<70% Fail)') {
      steps {
        script {
          echo "Checking SonarQube coverage threshold..."

          def response = sh(
            script: """
              curl -s -u ${SONAR_TOKEN}: \\
              "${SONAR_URL}/api/measures/component?component=${SONAR_PROJECT_KEY}&metricKeys=coverage"
            """,
            returnStdout: true
          ).trim()

          echo "SonarQube API Response: ${response}"

          def coverage = sh(
            script: "echo '${response}' | grep -o '\"value\":\"[0-9.]*\"' | sed 's/\"value\":\"//' | sed 's/\"//'",
            returnStdout: true
          ).trim()

          echo "📊 Coverage from SonarQube = ${coverage}%"

          if (coverage == "" || coverage == null) {
            error "❌ Unable to read code coverage from SonarQube!"
          }

          if (coverage.toFloat() < 20) {
            error "❌ Coverage = ${coverage}%. Threshold = 70%. Failing pipeline."
          }

          echo "✅ Coverage = ${coverage}%. Passed custom quality check."
        }
      }
    }

  }
}
